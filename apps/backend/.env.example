DATABASE_URL=postgresql://tema:tema@localhost:5432/tema_project_manager
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 / OIDC (ver docs/auth.md para cómo generarlas en Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Sesion propia (JWT en cookie HttpOnly). Generar un valor random largo, nunca versionar el real.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Dominio autorizado SOLO para desarrollo (ver "pnpm --filter @tema/backend seed:dev-domain")
AUTHORIZED_DOMAIN_DEV=
